from machine import Pin, I2C
from time import sleep
import BME280
nuevo_archivo = open("prueba4.csv", "w")

nuevo_archivo.write("Temperatura C°,")
nuevo_archivo.write("Presion hPa,")
nuevo_archivo.write("Humedad %, \n")


# ESP32 - Pin assignment
i2c = I2C(scl=Pin(22), sda=Pin(21), freq=10000)
# ESP8266 - Pin assignment
#i2c = I2C(scl=Pin(5), sda=Pin(4), freq=10000)
suma=0
while True:
  suma=suma + 1
  bme = BME280.BME280(i2c=i2c)
  temp = bme.temperature
  hum = bme.humidity
  pres = bme.pressure
  
  # uncomment for temperature in Fahrenheit
  #temp = (bme.read_temperature()/100) * (9/5) + 32
  #temp = str(round(temp, 2)) + 'F'
  print('Tiempo', suma)
  print('Temperature: ', temp)
  print('Humidity: ', hum)
  print('Pressure: ', pres)
  

  nuevo_archivo.write(str(temp+","))
  nuevo_archivo.write(str(pres+","))
  nuevo_archivo.write(str(hum+", \n"))
  

  


  sleep(1)
nuevo_archivo.close()

  
